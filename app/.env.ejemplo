# Copia este archivo como .env y rellénalo. Git ignora .env: no lo subas nunca.

# Dirección del proyecto de Supabase. Está en Project Settings > API.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública del proyecto (publishable o anon). Nunca la clave de servicio:
# lo que empieza por VITE_ acaba dentro de la web y lo puede leer cualquiera.
VITE_SUPABASE_CLAVE_PUBLICA=
