# Copia este archivo como .env y rellénalo. Git ignora .env: no lo subas nunca.

# Dirección del proyecto de Supabase. Está en Project Settings > API.
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública del proyecto (publishable o anon). Nunca la clave de servicio.
SUPABASE_CLAVE_PUBLICA=

# Correo de la persona administradora que hace la carga.
LIBRO_CORREO=

# Opcional, solo para desarrollo: si está, se entra con contraseña y no se envía el código por correo.
# En producción, la entrada con contraseña estará desactivada en Supabase: solo valdrá el código.
# LIBRO_CONTRASENA=
